# MetaTrader 5 terminal path (optional — auto-detected if omitted, but an
# explicit path is more reliable — see diagnostics/FINDINGS.md)
# MT5_PATH=E:\ProgramFiles\MT5\terminal64.exe

# Transport: stdio | sse | streamable-http (default). Do not use stdio for
# any tool that touches MetaTrader5 — see diagnostics/FINDINGS.md.
# MT5_MCP_TRANSPORT=streamable-http
# MT5_MCP_HTTP_HOST=127.0.0.1
# MT5_MCP_HTTP_PORT=3403

# Extra Host headers to accept when a reverse proxy (nginx) forwards a
# public hostname — without this, FastMCP's DNS-rebinding protection 421s
# every proxied request (it only trusts 127.0.0.1/localhost/::1 by default).
# Comma-separated, no auth implied — see README.md's "Public access" section.
# MT5_MCP_PUBLIC_HOSTNAMES=mt5-mcp-dev.delena.buzz

# Safety layer (see README.md's "Safety layer" section before changing any of these)
# MT5_MCP_DRY_RUN=false
# MT5_MCP_KILL_SWITCH_PATH=E:\MyWorkspace\MT5-MCP\MT5_MCP_KILL_SWITCH
# MT5_MCP_MAX_LOT_SIZE=0.10
# MT5_MCP_MAX_OPEN_POSITIONS=3

# Local SQLite state (gitignored, defaults live at the repo root)
# MT5_MCP_STREAM_LOG_DB=E:\MyWorkspace\MT5-MCP\mt5_mcp_stream_log.db
# MT5_MCP_AUDIT_LOG_DB=E:\MyWorkspace\MT5-MCP\mt5_mcp_audit_log.db
